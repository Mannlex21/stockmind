  "dataModels": {
    "types": {
      "ProductStatus": ["IN_STOCK", "LOW_STOCK", "OUT_OF_STOCK"],
      "OrderStatus": ["draft", "sent", "completed", "cancelled"],
      "DataEntryMode": ["MANUAL", "AI_GENERATED", "AI_EDITED"],
      "UnitOfMeasure": ["PCS", "KG", "G", "L", "ML"],
      "ReturnType": ["CUSTOMER_RETURN", "SUPPLIER_RETURN"],
      "ReturnReason": ["DAMAGED", "EXPIRED", "WRONG_ITEM", "CUSTOMER_REFUND"],
      "WarehouseStatusFilter": ["ALL", "ACTIVE", "INACTIVE"]
    },
    "interfaces": {
      "Warehouse": {
        "id": "string",
        "code": "string",
        "name": "string",
        "location": "string (optional)",
        "description": "string (optional)",
        "isMain": "boolean",
        "allowSales": "boolean",
        "isActive": "boolean",
        "createdAt": "Date | string (optional)",
        "updatedAt": "Date | string (optional)"
      },
      "WarehouseStock": {
        "warehouseId": "string",
        "warehouseName": "string",
        "stock": "number (readonly in product modal)"
      },
      "ProductBatch": {
        "id": "string",
        "batchNumber": "string",
        "expirationDate": "Date | string",
        "quantity": "number",
        "warehouseId": "string (optional)"
      },
      "ProductPresentation": {
        "id": "string",
        "name": "string",
        "parentPresentationId": "string (optional)",
        "baseConversionFactor": "number",
        "price": "number",
        "priceWithTax": "number (optional)",
        "barcode": "string (optional)",
        "sku": "string (optional)"
      },
      "Product": {
        "id": "string",
        "sku": "string",
        "barcodes": "string[] (optional)",
        "name": "string",
        "brand": "string (optional)",
        "category": "string",
        "subcategory": "string (optional)",
        "isActive": "boolean",
        "useInPOS": "boolean",
        "trackStock": "boolean",
        "baseUnit": "UnitOfMeasure",
        "stock": "number (calculated aggregate)",
        "pendingToReceive": "number",
        "pendingToServe": "number",
        "accumulatedEntries": "number (optional)",
        "accumulatedExits": "number (optional)",
        "minStock": "number",
        "maxStock": "number (optional)",
        "costPrice": "number",
        "costPriceWithTax": "number (optional)",
        "unitPrice": "number",
        "unitPriceWithTax": "number",
        "taxRate": "number",
        "useBatchExpiration": "boolean (optional)",
        "useSerialNumbers": "boolean (optional)",
        "stocksByWarehouse": "WarehouseStock[] (optional)",
        "batches": "ProductBatch[] (optional)",
        "presentations": "ProductPresentation[] (optional)",
        "supplier": "string",
        "lastUpdated": "Date | string",
        "entryMode": "DataEntryMode (optional)",
        "status": "ProductStatus (optional)"
      },
      "ReturnTransaction": {
        "id": "string",
        "productId": "string",
        "productName": "string",
        "type": "ReturnType",
        "reason": "ReturnReason",
        "presentationId": "string (optional)",
        "quantityReturned": "number",
        "baseQuantity": "number",
        "restockInventory": "boolean",
        "totalAmount": "number",
        "date": "Date | string",
        "notes": "string (optional)",
        "entryMode": "DataEntryMode (optional)"
      },
      "PurchaseOrderItem": {
        "productId": "string",
        "productName": "string",
        "quantityToOrder": "number",
        "estimatedCost": "number",
        "supplier": "string",
        "presentationId": "string (optional)",
        "presentationName": "string (optional)"
      },
      "PurchaseOrder": {
        "id": "string",
        "orderNumber": "string",
        "date": "Date | string",
        "supplier": "string",
        "items": "PurchaseOrderItem[]",
        "totalCost": "number",
        "status": "OrderStatus",
        "notes": "string (optional)",
        "entryMode": "DataEntryMode (optional)",
        "createdAt": "Date | string (optional)",
        "updatedAt": "Date | string (optional)"
      },
      "OrderFilter": {
        "search": "string",
        "status": "OrderStatus | 'ALL'"
      },
      "OrderStats": {
        "totalOrders": "number",
        "draftCount": "number",
        "sentCount": "number",
        "completedCount": "number",
        "totalEstimatedSpend": "number"
      },
      "InvoiceItemScan": {
        "description": "string",
        "sku": "string (optional)",
        "quantity": "number",
        "unitPrice": "number",
        "totalPrice": "number",
        "detectedPresentation": "string (optional)",
        "matchedProductId": "string (optional)",
        "confidenceScore": "number (optional)",
        "isManuallyVerified": "boolean"
      },
      "InvoiceScanResult": {
        "invoiceNumber": "string",
        "supplierName": "string",
        "issueDate": "string",
        "totalAmount": "number",
        "items": "InvoiceItemScan[]",
        "rawText": "string (optional)"
      },
      "InventoryStats": {
        "totalProducts": "number",
        "lowStockCount": "number",
        "totalValue": "number",
        "pendingOrders": "number"
      }
    }
  }
}
